# Copy to .env and replace both passwords before the first start.
# Passwords are only applied when the admin user / app user are first created.
COUCHDB_USER=admin
COUCHDB_PASSWORD=replace-with-a-long-random-password

# Database used by the app and the least-privilege CouchDB user that reaches it.
COUCHDB_DB=thenoter
COUCHDB_APP_USER=thenoter
COUCHDB_APP_PASSWORD=replace-with-another-long-random-password

# URL the browser uses. For app-only exposure via Tailscale Serve, use a
# root-relative path through the frontend proxy (e.g. /couchdb/thenoter).
# Keep http://127.0.0.1:5984/thenoter only for direct local access.
SYNC_URL=/couchdb/thenoter
