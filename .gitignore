# Frontend build output
/frontend/dist
/frontend/tmp
/frontend/out-tsc
/frontend/bazel-out
/frontend/.angular/cache
/frontend/node_modules
/frontend/npm-debug.log
/frontend/yarn-error.log

# Backend runtime data (CouchDB database files)
/backend/data/*
!/backend/data/.gitignore

# Local environment / secrets
.env

# Generated at dev/build time from .env; the container rewrites it at startup.
/frontend/public/sync-config.json

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/mcp.json
.history/*

# Miscellaneous
.sass-cache/
/connect.lock
/coverage
/frontend/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
